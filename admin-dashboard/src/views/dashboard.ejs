<%- include('partials/header', { title: 'Dashboard - RepairWidget Admin' }) %>
<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<div class="main-content">
  <%- include('partials/navbar') %>

  <!-- Main Dashboard Body -->
  <main class="page-body">
    <!-- Welcome Header & Action Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
      <div> 
        <h3 class="fw-bold text-dark mb-1">Dashboard Overview</h3>
        <p class="text-muted mb-0 small">Welcome back, Alex! Here is your repair shop performance summary.</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill small">
          <i class="bi bi-calendar3 me-1 text-primary"></i> Today: Nov 19, 2026
        </span>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
          <i class="bi bi-download me-1"></i> Export Report
        </button>
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
          <i class="bi bi-plus-lg me-1"></i> New Repair Ticket
        </button>
      </div>
    </div>

    <!-- 4 KPI Metrics Row -->
    <div class="row g-3 mb-4">
      <!-- Metric 1: Total Revenue -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-hover border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small fw-semibold">Total Revenue</span>
              <div class="metric-icon-box metric-icon-primary">
                <i class="bi bi-currency-dollar"></i>
              </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">$48,650.00</h3>
            <div class="d-flex align-items-center gap-2">
              <span class="trend-pill trend-up">
                <i class="bi bi-arrow-up-right"></i> +12.8%
              </span>
              <span class="text-muted small">vs last month</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Metric 2: Active Repair Jobs -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-hover border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small fw-semibold">Active Repair Jobs</span>
              <div class="metric-icon-box metric-icon-info">
                <i class="bi bi-wrench-adjustable"></i>
              </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">1,342</h3>
            <div class="d-flex align-items-center gap-2">
              <span class="trend-pill trend-up">
                <i class="bi bi-arrow-up-right"></i> +5.4%
              </span>
              <span class="text-muted small">28 added today</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Metric 3: Completed Repairs -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-hover border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small fw-semibold">Completed Services</span>
              <div class="metric-icon-box metric-icon-success">
                <i class="bi bi-check2-circle"></i>
              </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">4,890</h3>
            <div class="d-flex align-items-center gap-2">
              <span class="trend-pill trend-up">
                <i class="bi bi-arrow-up-right"></i> +18.2%
              </span>
              <span class="text-muted small">98.4% success rate</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Metric 4: Pending Inquiries -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-hover border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small fw-semibold">Pending Inquiries</span>
              <div class="metric-icon-box metric-icon-warning">
                <i class="bi bi-clock-history"></i>
              </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">37</h3>
            <div class="d-flex align-items-center gap-2">
              <span class="trend-pill trend-down">
                <i class="bi bi-arrow-down-right"></i> -2.6%
              </span>
              <span class="text-muted small">Avg response: 12 min</span>
            </div>
          </div>
        </div>
      </div>
