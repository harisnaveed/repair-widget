<!-- Sidebar -->
<aside id="sidebar" class="sidebar">
  <!-- Brand Logo & Name -->
  <div class="brand-wrapper">
    <a href="/" class="brand-title">
      <div class="brand-icon">
        <i class="bi bi-tools"></i>
      </div>
      <span>RepairWidget</span>
    </a>
  </div>

  <!-- Navigation Links -->
  <div class="sidebar-nav">
    <div class="sidebar-heading">Main</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a
          class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>"
          href="/"
        >
          <i class="bi bi-grid-1x2-fill"></i>
          <span>Dashboard</span>
        </a>
      </li>
    </ul>

    <div class="sidebar-heading">Components & UI</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a
          class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'devices' ? 'active' : '' %>"
          href="/devices"
        >
          <i class="bi bi-phone"></i>
          <span>Devices</span>
          <!-- <span class="badge bg-secondary nav-badge">12</span> -->
        </a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'tables' ? 'active' : '' %>"
          href="/tables"
        >
          <i class="bi bi-table"></i>
          <span>Data Tables</span>
          <span class="badge bg-secondary nav-badge">12</span>
        </a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'forms' ? 'active' : '' %>"
          href="/forms"
        >
          <i class="bi bi-input-cursor-text"></i>
          <span>Forms & Inputs</span>
        </a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'modals' ? 'active' : '' %>"
          href="/modals"
        >
          <i class="bi bi-window-stack"></i>
          <span>Modals & Alerts</span>
          <span class="badge bg-primary nav-badge">New</span>
        </a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'active' : '' %>"
          href="/products"
        >
          <i class="bi bi-box-seam-fill"></i>
          <span>Product Cards</span>
          <span class="badge bg-success nav-badge">8</span>
        </a>
      </li>
    </ul>

    <div class="sidebar-heading">Settings</div>
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link" href="#">
          <i class="bi bi-gear-fill"></i>
          <span>Settings</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#">
          <i class="bi bi-shield-lock-fill"></i>
          <span>Security</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-danger" href="#">
          <i class="bi bi-box-arrow-right text-danger"></i>
          <span>Logout</span>
        </a>
      </li>
    </ul>
  </div>

  <!-- Sidebar Footer / Status Card -->
  <div class="sidebar-footer">
    <div class="sidebar-storage-card">
      <div
        class="d-flex justify-content-between align-items-center mb-1 text-white small"
      >
        <span><i class="bi bi-hdd-network me-1"></i> Storage</span>
        <span>78%</span>
      </div>
      <div
        class="progress mb-2"
        style="height: 5px; background: rgba(255, 255, 255, 0.1)"
      >
        <div
          class="progress-bar bg-primary"
          role="progressbar"
          style="width: 78%"
          aria-valuenow="78"
          aria-valuemin="0"
          aria-valuemax="100"
        ></div>
      </div>
      <p class="mb-0 text-muted" style="font-size: 0.72rem">
        15.6 GB of 20 GB used
      </p>
    </div>
  </div>
</aside>
