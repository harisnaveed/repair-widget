<!-- Top Navbar -->
<header class="top-navbar">
  <div class="d-flex align-items-center gap-3">
    <!-- Sidebar Toggle Button -->
    <button id="sidebar-toggle" class="icon-btn" type="button" aria-label="Toggle navigation">
      <i class="bi bi-list fs-4"></i>
    </button>

    <!-- Global Search Box -->
    <div class="search-box d-none d-md-block">
      <i class="bi bi-search search-icon"></i>
      <input type="text" class="form-control" placeholder="Search orders, customers, products...">
    </div>
  </div>

  <!-- Right Actions: Notifications, Messages & User Profile -->
  <div class="d-flex align-items-center gap-2">
    <!-- Search Button for Mobile -->
    <button class="icon-btn d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch">
      <i class="bi bi-search"></i>
    </button>

    <!-- Notifications Dropdown -->
    <div class="dropdown">
      <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell"></i>
        <span class="badge-dot bg-danger"></span>
      </button>
      <div class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="width: 300px;">
        <div class="d-flex justify-content-between align-items-center px-2 py-1 mb-2 border-bottom">
          <h6 class="mb-0 fw-bold">Notifications</h6>
          <span class="badge bg-primary rounded-pill">3 New</span>
        </div>
        <div class="list-group list-group-flush">
          <a href="#" class="list-group-item list-group-item-action border-0 rounded px-2 py-2 mb-1">
            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
              <span class="fw-semibold small text-dark"><i class="bi bi-wrench me-1 text-primary"></i> New Repair Ticket</span>
              <small class="text-muted">5m ago</small>
            </div>
            <p class="mb-0 small text-muted">iPhone 14 screen replacement submitted.</p>
          </a>
          <a href="#" class="list-group-item list-group-item-action border-0 rounded px-2 py-2 mb-1">
            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
              <span class="fw-semibold small text-dark"><i class="bi bi-check-circle me-1 text-success"></i> Payment Approved</span>
              <small class="text-muted">1h ago</small>
            </div>
            <p class="mb-0 small text-muted">Invoice #1042 marked as paid ($180).</p>
          </a>
          <a href="#" class="list-group-item list-group-item-action border-0 rounded px-2 py-2">
            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
              <span class="fw-semibold small text-dark"><i class="bi bi-exclamation-triangle me-1 text-warning"></i> Low Stock Alert</span>
              <small class="text-muted">3h ago</small>
            </div>
            <p class="mb-0 small text-muted">Only 2 OLED displays left in inventory.</p>
          </a>
        </div>
        <div class="text-center pt-2 mt-1 border-top">
          <a href="#" class="small text-primary text-decoration-none fw-semibold">View All Notifications</a>
        </div>
      </div>
    </div>

    <!-- Messages Dropdown -->
    <div class="dropdown">
      <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-chat-left-text"></i>
        <span class="badge-dot bg-primary"></span>
      </button>
      <div class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="width: 280px;">
        <div class="d-flex justify-content-between align-items-center px-2 py-1 mb-2 border-bottom">
          <h6 class="mb-0 fw-bold">Messages</h6>
          <span class="badge bg-secondary rounded-pill">2 Unread</span>
        </div>
        <a href="#" class="dropdown-item rounded p-2 mb-1 d-flex gap-2 align-items-center">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem;">
            JD
          </div>
          <div>
            <div class="fw-semibold small">John Doe</div>
            <div class="text-muted small text-truncate" style="max-width: 180px;">Is my MacBook repair ready?</div>
          </div>
        </a>
        <a href="#" class="dropdown-item rounded p-2 d-flex gap-2 align-items-center">
          <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem;">
            SA
          </div>
          <div>
            <div class="fw-semibold small">Sarah Adams</div>
            <div class="text-muted small text-truncate" style="max-width: 180px;">Thanks for the quick service!</div>
          </div>
        </a>
      </div>
    </div>

    <!-- Vertical Divider -->
    <div class="vr mx-2 text-secondary opacity-25" style="height: 24px;"></div>

    <!-- User Profile Dropdown -->
    <div class="dropdown">
      <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80" alt="Avatar" class="avatar-img">
        <div class="d-none d-lg-block text-start">
          <div class="fw-semibold small text-dark line-height-1">Alex Morgan</div>
          <div class="text-muted small" style="font-size: 0.75rem;">Administrator</div>
        </div>
      </a>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
        <li>
          <div class="px-3 py-2 border-bottom mb-1">
            <p class="mb-0 fw-bold small text-dark">Alex Morgan</p>
            <p class="mb-0 text-muted small">alex@repairwidget.io</p>
          </div>
        </li>
        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-person me-2 text-primary"></i> My Profile</a></li>
        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-gear me-2 text-secondary"></i> Account Settings</a></li>
        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-credit-card me-2 text-info"></i> Billing & Plans</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item py-2 text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a></li>
      </ul>
    </div>
  </div>
</header>

<!-- Mobile Search Bar Collapse -->
<div class="collapse p-3 bg-white border-bottom d-md-none" id="mobileSearch">
  <div class="search-box w-100">
    <i class="bi bi-search search-icon"></i>
    <input type="text" class="form-control" placeholder="Search orders, customers, products...">
  </div>
</div>
