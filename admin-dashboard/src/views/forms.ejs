<%- include('partials/header', { title: 'Forms & Inputs - RepairWidget Admin' }) %>
<%- include('partials/sidebar', { activePage: 'forms' }) %>

<div class="main-content">
  <%- include('partials/navbar') %>

  <!-- Forms Page Body -->
  <main class="page-body">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
      <div>
        <h3 class="fw-bold text-dark mb-1">Forms & Inputs</h3>
        <p class="text-muted mb-0 small">A comprehensive set of modern form controls, selects, toggles, validation, and file upload fields.</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Discard</button>
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">Save Record</button>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left Column: Main Intake Form -->
      <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Repair Ticket Information</h6>
          </div>
          <div class="card-body p-4">
            <form>
              <!-- Row 1: Customer Details -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Customer Full Name <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" placeholder="e.g. Sarah Connor" required>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Email Address <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" placeholder="sarah@example.com" required>
                  </div>
                </div>
              </div>

              <!-- Row 2: Phone & Contact Preference -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Phone Number</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted">+1</span>
                    <input type="tel" class="form-control" placeholder="(555) 000-0000">
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Contact Preference</label>
                  <select class="form-select">
                    <option selected>SMS / Text Message</option>
                    <option value="1">Email</option>
                    <option value="2">Phone Call</option>
                    <option value="3">WhatsApp</option>
                  </select>
                </div>
              </div>

              <hr class="my-4 text-muted opacity-25">

              <!-- Row 3: Device Info -->
              <h6 class="fw-bold text-dark mb-3 small text-uppercase letter-spacing-1">Device Details</h6>
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-4">
                  <label class="form-label small fw-semibold text-secondary">Device Category</label>
                  <select class="form-select">
                    <option selected>Smartphone</option>
                    <option value="1">Laptop</option>
                    <option value="2">Tablet</option>
                    <option value="3">Gaming Console</option>
                    <option value="4">Smartwatch</option>
                  </select>
                </div>
                <div class="col-12 col-md-4">
                  <label class="form-label small fw-semibold text-secondary">Brand</label>
                  <input type="text" class="form-control" placeholder="e.g. Apple, Samsung, Dell">
                </div>
                <div class="col-12 col-md-4">
                  <label class="form-label small fw-semibold text-secondary">Model / Serial No.</label>
                  <input type="text" class="form-control" placeholder="e.g. iPhone 15 Pro Max">
                </div>
              </div>

              <!-- Row 4: Pricing & Dates -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Estimated Price</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted">$</span>
                    <input type="number" step="0.01" class="form-control" placeholder="150.00">
                    <span class="input-group-text bg-light text-muted">USD</span>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Target Completion Date</label>
                  <input type="date" class="form-control">
                </div>
              </div>

              <!-- Issue Description -->
              <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">Issue Description & Diagnostic Notes</label>
                <textarea class="form-control" rows="4" placeholder="Detail the device symptoms, visible physical damage, passcode, and customer requests..."></textarea>
                <div class="form-text small">Provide as much detail as possible to assist the technician.</div>
              </div>

              <!-- Form Buttons -->
              <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <button type="reset" class="btn btn-light border px-4">Reset</button>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Submit Ticket</button>
              </div>
            </form>
          </div>
        </div>

        <!-- File Upload Dropzone Card -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-cloud-arrow-up me-2 text-primary"></i>Device Photos & Documents</h6>
          </div>
          <div class="card-body p-4">
            <div class="file-dropzone">
              <i class="bi bi-cloud-arrow-up-fill text-primary" style="font-size: 3rem;"></i>
              <h6 class="mt-3 fw-bold text-dark">Drag and drop images or files here</h6>
              <p class="text-muted small mb-3">Support for PNG, JPG, or PDF up to 10MB</p>
              <label class="btn btn-outline-primary btn-sm rounded-pill px-4">
                Browse Files
                <input type="file" hidden multiple>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Options, Switches & Validation Showcase -->
      <div class="col-12 col-xl-4">
        <!-- Settings & Switches -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-toggles me-2 text-primary"></i>Ticket Settings & Toggles</h6>
          </div>
          <div class="card-body p-4">
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" role="switch" id="switchNotification" checked>
              <label class="form-check-label fw-semibold small text-dark" for="switchNotification">Customer SMS Updates</label>
              <div class="text-muted small" style="font-size: 0.75rem;">Send automated progress alerts to the client.</div>
            </div>

            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" role="switch" id="switchWarranty" checked>
              <label class="form-check-label fw-semibold small text-dark" for="switchWarranty">Apply 90-Day Warranty</label>
              <div class="text-muted small" style="font-size: 0.75rem;">Include standard labor and parts guarantee.</div>
            </div>

            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" role="switch" id="switchExpress">
              <label class="form-check-label fw-semibold small text-dark" for="switchExpress">Express Rush Service (+$35)</label>
              <div class="text-muted small" style="font-size: 0.75rem;">Prioritize this ticket on technician queue.</div>
            </div>

            <hr class="my-3 text-muted opacity-25">

            <!-- Radio Options -->
            <label class="form-label fw-semibold small text-secondary mb-2">Priority Level</label>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="priorityRadio" id="prioLow">
              <label class="form-check-label small" for="prioLow">Standard / Normal (3-5 days)</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="priorityRadio" id="prioMedium" checked>
              <label class="form-check-label small" for="prioMedium">Medium (1-2 days)</label>
            </div>
            <div class="form-check mb-3">
              <input class="form-check-input" type="radio" name="priorityRadio" id="prioHigh">
              <label class="form-check-label small text-danger fw-semibold" for="prioHigh">High Priority / Urgent (Same day)</label>
            </div>

            <!-- Range Slider -->
            <label for="diagnosticScore" class="form-label fw-semibold small text-secondary">Battery Health Score (%)</label>
            <input type="range" class="form-range" min="0" max="100" value="84" id="diagnosticScore">
            <div class="d-flex justify-content-between text-muted small" style="font-size: 0.75rem;">
              <span>0% (Replace)</span>
              <span class="fw-bold text-dark">84%</span>
              <span>100% (Optimal)</span>
            </div>
          </div>
        </div>

        <!-- Validation Showcase Card -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check me-2 text-success"></i>Validation Showcase</h6>
          </div>
          <div class="card-body p-4">
            <!-- Valid Field -->
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Verified Invoice Code</label>
              <div class="input-group">
                <input type="text" class="form-control is-valid" value="INV-2026-994">
                <span class="input-group-text bg-white text-success border-success"><i class="bi bi-check-lg"></i></span>
              </div>
              <div class="valid-feedback small">Verified! Invoice is active and payable.</div>
            </div>

            <!-- Invalid Field -->
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">IMEI / Serial Number</label>
              <div class="input-group">
                <input type="text" class="form-control is-invalid" value="3524">
                <span class="input-group-text bg-white text-danger border-danger"><i class="bi bi-exclamation-circle"></i></span>
              </div>
              <div class="invalid-feedback small">Invalid format. Standard IMEI requires 15 numeric digits.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

<%- include('partials/footer') %>
