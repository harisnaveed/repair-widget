<%- include('../partials/header', { title: 'Devices Management - RepairWidget Admin' }) %>
<%- include('../partials/sidebar', { activePage: 'devices' }) %>

<!-- DataTables Bootstrap 5 CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap5.min.css">

<style>
  /* Custom DataTables Styling to match dashboard theme */
  div.dt-container .dt-search input {
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.875rem;
    border: 1px solid #dee2e6;
    background-color: #f8fafc;
  }
  div.dt-container .dt-length select {
    border-radius: 8px;
    padding: 5px 28px 5px 12px;
    font-size: 0.875rem;
    border: 1px solid #dee2e6;
  }
  div.dt-container div.dt-layout-row {
    padding: 12px 18px;
  }
  .table > :not(caption) > * > * {
    padding: 12px 16px;
  }
</style>

<div class="main-content">
  <%- include('../partials/navbar') %>

  <!-- Devices Page Body -->
  <main class="page-body">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
      <div>
        <h3 class="fw-bold text-dark mb-1">Devices Management</h3>
        <p class="text-muted mb-0 small">Manage device categories (Smartphones, Laptops, Tablets, etc.) displayed in the repair widget.</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
          <i class="bi bi-file-earmark-arrow-down me-1"></i> Export
        </button>
        <!-- Add Device Modal Trigger Button -->
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
          <i class="bi bi-plus-lg me-1"></i> Add Device
        </button>
      </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-0">
        <!-- Responsive DataTable -->
        <div class="table-responsive p-3">
          <table id="devicesTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
              <tr>
                <th style="width: 50px;">#</th>
                <th>Device Name</th>
                <th>Slug</th>
                <th>Description</th>
                <th>Status</th>
                <th>Created At</th>
                <th class="text-end" style="width: 110px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof devices !== 'undefined' && devices.length > 0) { %>
                <% devices.forEach((device, index) => { %>
                  <tr>
                    <td>
                      <span class="text-muted fw-bold small"><%= device.order || index + 1 %></span>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2.5">
                        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1.15rem;">
                          <i class="bi <%= device.icon || 'bi-phone' %>"></i>
                        </div>
                        <div>
                          <div class="fw-bold text-dark"><%= device.name %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <code class="text-primary small px-2 py-1 bg-light rounded border"><%= device.slug %></code>
                    </td>
                    <td>
                      <span class="text-muted small text-truncate d-inline-block" style="max-width: 280px;" title="<%= device.description %>">
                        <%= device.description || '—' %>
                      </span>
                    </td>
                    <td>
                      <% if (device.status === 'active') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>
                      <% } %>
                    </td>
                    <td class="text-muted small">
                      <%= device.createdAt ? new Date(device.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %>
                    </td>
                    <td class="text-end">
                      <div class="btn-group btn-group-sm">
                        <button class="btn btn-light border py-1 px-2 text-primary" title="View"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-light border py-1 px-2 text-dark" title="Edit"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-light border py-1 px-2 text-danger" title="Delete"><i class="bi bi-trash"></i></button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <!-- Add Device Modal -->
  <div class="modal fade" id="addDeviceModal" tabindex="-1" aria-labelledby="addDeviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-light border-bottom">
          <h5 class="modal-title fw-bold text-dark" id="addDeviceModalLabel">
            <i class="bi bi-plus-circle me-1 text-primary"></i> Add New Device
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/devices/add" method="POST">
          <div class="modal-body p-4">
            <!-- Name -->
            <div class="mb-3">
              <label for="deviceName" class="form-label fw-semibold small">Device Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="deviceName" name="name" placeholder="e.g. Smartphone, Laptop, Tablet" required>
            </div>

            <!-- Description -->
            <div class="mb-3">
              <label for="deviceDescription" class="form-label fw-semibold small">Description</label>
              <textarea class="form-control" id="deviceDescription" name="description" rows="3" placeholder="Brief description of devices in this category..."></textarea>
            </div>

            <!-- Icon & Order -->
            <div class="row g-3 mb-3">
              <div class="col-sm-8">
                <label for="deviceIcon" class="form-label fw-semibold small">Bootstrap Icon Class</label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-muted" id="iconPreview"><i class="bi bi-phone"></i></span>
                  <input type="text" class="form-control" id="deviceIcon" name="icon" value="bi-phone" placeholder="e.g. bi-phone, bi-laptop" oninput="updateIconPreview(this.value)">
                </div>
                <div class="form-text small" style="font-size: 0.72rem;">Browse <a href="https://icons.getbootstrap.com/" target="_blank">Bootstrap Icons</a> for icon names.</div>
              </div>
              <div class="col-sm-4">
                <label for="deviceOrder" class="form-label fw-semibold small">Sort Order</label>
                <input type="number" class="form-control" id="deviceOrder" name="order" value="0" min="0">
              </div>
            </div>

            <!-- Status (Radio buttons) -->
            <div class="mb-2">
              <label class="form-label fw-semibold small d-block mb-2">Status</label>
              <div class="d-flex gap-4">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="status" id="statusActive" value="active" checked>
                  <label class="form-check-label small" for="statusActive">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="status" id="statusInactive" value="inactive">
                  <label class="form-check-label small" for="statusInactive">
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light border-top">
            <button type="button" class="btn btn-light border rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Device</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- jQuery & DataTables JS -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap5.min.js"></script>

  <script>
    function updateIconPreview(val) {
      const icon = val.trim() ? (val.startsWith('bi-') ? val : 'bi-' + val) : 'bi-phone';
      document.querySelector('#iconPreview i').className = 'bi ' + icon;
    }

    $(document).ready(function() {
      $('#devicesTable').DataTable({
        responsive: true,
        pageLength: 10,
        order: [[0, 'asc']], // Order by first column (#)
        columnDefs: [
          { orderable: false, targets: [-1] } // Disable sorting on 'Actions' column
        ],
        language: {
          search: "",
          searchPlaceholder: "Search devices...",
          lengthMenu: "_MENU_ per page"
        }
      });
    });
  </script>

<%- include('../partials/footer') %>
